{
  "name": "ltx-video-monitor",
  "version": "1.5.0",
  "description": "A private local dashboard and human-in-the-loop studio for LTX Video monitoring, shot review, queues, playback, and process control.",
  "private": true,
  "homepage": "https://github.com/Orffyrus-Qc/ltx-watch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orffyrus-Qc/ltx-watch.git"
  },
  "keywords": [
    "ltx-video",
    "ltx-2",
    "comfyui",
    "video-generation",
    "local-dashboard"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.mjs dev",
    "dev:studio": "node scripts/run-studio.mjs",
    "site:dev": "vinext dev",
    "build": "vinext build",
    "build:msi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-msi.ps1",
    "start": "node scripts/run-local.mjs start",
    "site:start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --test",
    "test:studio": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  },
  "type": "module"
}
